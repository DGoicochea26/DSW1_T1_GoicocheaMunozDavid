@model ResultadoPaginado<Libro>
@{
    ViewData["Title"] = "Buscar por autor";
    bool buscado = ViewBag.Buscado == true;
}

<h1 class="h3 mb-3">Buscar libros por autor</h1>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="BuscarPorAutor" method="get" class="row g-2">
            <div class="col-12 col-md">
                <label for="autor" class="visually-hidden">Autor</label>
                <input type="text" id="autor" name="autor" value="@ViewBag.Autor" maxlength="100"
                       class="form-control" placeholder="Nombre o parte del nombre del autor" required />
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a class="btn btn-outline-secondary" asp-action="BuscarPorAutor">Nueva búsqueda</a>
                <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
else if (buscado)
{
    <div class="alert @(Model.Items.Any() ? "alert-success" : "alert-warning")">@ViewBag.Mensaje</div>
}

@if (buscado && Model.Items.Any())
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Nombre del libro</th>
                        <th>Autor</th>
                        <th>Editorial</th>
                        <th>ISDN</th>
                        <th>Categoría</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td>@l.Id</td>
                            <td>@l.NombreLibro</td>
                            <td>@l.Autor</td>
                            <td>@l.NombreEditorial</td>
                            <td>@l.ISDN</td>
                            <td>@(l.NombreCategoria ?? "Sin categoría")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (buscado)
{
    @await Html.PartialAsync("_Paginacion", new Paginador(Model.PaginaActual, Model.TotalPaginas, Model.TotalRegistros, "BuscarPorAutor", (string?)ViewBag.Autor))
}
