@model ResultadoPaginado<Libro>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Libros registrados</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="BuscarPorAutor">Buscar por autor</a>
        <a class="btn btn-primary" asp-action="Crear">Registrar libro</a>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Id</th>
                    <th>Nombre del libro</th>
                    <th>Autor</th>
                    <th>Editorial</th>
                    <th>ISDN</th>
                    <th>Categoría</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Items)
                {
                    <tr>
                        <td>@l.Id</td>
                        <td>@l.NombreLibro</td>
                        <td>@l.Autor</td>
                        <td>@l.NombreEditorial</td>
                        <td>@l.ISDN</td>
                        <td>@(l.NombreCategoria ?? "Sin categoría")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@l.Id">Editar</a>
                                <form asp-action="Eliminar" method="post" class="d-inline"
                                      data-nombre="@l.NombreLibro"
                                      onsubmit="return confirm('¿Desea eliminar el libro «' + this.dataset.nombre + '»?');">
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <input type="hidden" name="pagina" value="@Model.PaginaActual" />
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Aún no hay libros registrados. <a asp-action="Crear">Registre el primero</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_Paginacion", new Paginador(Model.PaginaActual, Model.TotalPaginas, Model.TotalRegistros, "Index", null))
