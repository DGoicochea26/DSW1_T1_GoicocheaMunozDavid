@using Microsoft.AspNetCore.Mvc.Rendering
@model Libro

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="NombreLibro" class="form-label"></label>
    <input asp-for="NombreLibro" class="form-control" maxlength="120" required />
    <span asp-validation-for="NombreLibro" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Autor" class="form-label"></label>
    <input asp-for="Autor" class="form-control" maxlength="100" required />
    <span asp-validation-for="Autor" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="NombreEditorial" class="form-label"></label>
    <input asp-for="NombreEditorial" class="form-control" maxlength="100" required />
    <span asp-validation-for="NombreEditorial" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ISDN" class="form-label"></label>
    <input asp-for="ISDN" class="form-control" maxlength="20" required />
    <span asp-validation-for="ISDN" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="IdCategoria" class="form-label"></label>
    <select asp-for="IdCategoria" asp-items="(SelectList)ViewBag.Categorias" class="form-select" required>
        <option value="">Seleccione una categoría</option>
    </select>
    <span asp-validation-for="IdCategoria" class="text-danger"></span>
</div>
